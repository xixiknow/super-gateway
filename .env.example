GATEWAY_DATA_BIND=0.0.0.0:8080
GATEWAY_ADMIN_BIND=127.0.0.1:8081
GATEWAY_DATABASE_URL_FILE=C:\path\to\runtime-database-url
GATEWAY_MIGRATOR_DATABASE_URL_FILE=C:\path\to\migrator-database-url
GATEWAY_BUSINESS_KEY_PROVIDER=database
GATEWAY_DIGEST_KEY_FILE=C:\path\to\lookup-digest-key
# GATEWAY_APP_KEY_FILE=C:\path\to\business-key
# GATEWAY_KEY_PROVIDER_URI=vault://business-key
GATEWAY_AUDIT_INTEGRITY_KEY_FILE=C:\path\to\audit-integrity-key
GATEWAY_BUNDLE_TRUST_STORE=C:\path\to\bundle-trust-store.json
GATEWAY_BUNDLE_DIR=C:\path\to\bundles
GATEWAY_RESPONSE_TMP_DIR=C:\path\to\response-tmp
# Linux 可选：启用全自动 Managed Browser reauth；该程序只通过 stdin/stdout 交换有界 JSON。
# GATEWAY_MANAGED_BROWSER_TOOL=C:\path\to\super-gateway-managed-browser
# GATEWAY_MANAGED_BROWSER_TIMEOUT=300s
GATEWAY_DRAIN_DEADLINE=300s
GATEWAY_BOOTSTRAP_ADMIN_USERNAME=admin
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_AT_DEPLOYMENT
RUST_LOG=info
RUST_BACKTRACE=0

    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": {
              "x-gateway-response-source": {
                "description": "Declares that the probe response was generated by the gateway.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "gateway"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "The isolated source-IP probe bucket is exhausted.",
            "headers": {
              "x-gateway-response-source": {
                "description": "Declares that the probe response was generated by the gateway.",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "gateway"
                }
              },
              "retry-after": {
                "description": "Whole seconds until the source-IP probe bucket can accept another request.",
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/common.schema.json#/$defs/PublicProbeRateLimited"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {

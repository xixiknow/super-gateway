{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-gateway.local/contracts/schemas/audit-approval.schema.json",
  "title": "Approval Contracts",
  "$defs": {
    "StepUpPurpose": {
      "type": "string",
      "enum": [
        "key_secret_reveal",
        "irreversible_lifecycle",
        "approval_decision",
        "key_provider_change",
        "backup_restore_security",
        "bundle_activation",
        "device_rebuild"
      ],
      "x-enum-registry": "step_up_purpose"
    },
    "ApprovalKind": {
      "type": "string",
      "enum": [
        "device_rebuild",
        "key_provider_change"
      ],
      "x-enum-registry": "approval_kind"
    },
    "ApprovalState": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "revoked"
      ],
      "x-enum-registry": "approval_state"
    },
    "StepUpGrant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/StepUpPurpose"
        },
        "actor_user_id": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "consumed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "actor_user_id",
        "expires_at"
      ]
    },
    "ApprovalCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ApprovalKind"
        },
        "scope": {
          "type": "object",
          "additionalProperties": true
        },
        "requested_by": {
          "type": "string"
        },
        "request_step_up_grant_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "action_snapshot_digest": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "$ref": "#/$defs/ApprovalState"
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_step_up_grant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope",
        "requested_by",
        "request_step_up_grant_id",
        "reason",
        "action_snapshot_digest",
        "requested_at",
        "expires_at",
        "state",
        "revision"
      ]
    }
  }
}

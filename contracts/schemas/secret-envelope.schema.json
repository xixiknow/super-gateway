{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-gateway.local/contracts/schemas/secret-envelope.schema.json",
  "title": "R2 Secret Envelope Contract",
  "$defs": {
    "SecretEnvelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "cipher_suite": {
          "type": "string",
          "const": "aes_256_gcm"
        },
        "provider_role": {
          "type": "string",
          "enum": [
            "business",
            "content_audit",
            "backup",
            "audit_integrity"
          ]
        },
        "key_version": {
          "type": "integer",
          "minimum": 1
        },
        "ciphertext_base64": {
          "type": "string",
          "minLength": 1
        },
        "nonce_base64": {
          "type": "string",
          "minLength": 16
        },
        "wrapped_dek_base64": {
          "type": "string",
          "minLength": 1
        },
        "aad_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 8,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "cipher_suite",
        "provider_role",
        "key_version",
        "ciphertext_base64",
        "nonce_base64",
        "wrapped_dek_base64",
        "aad_fields"
      ]
    }
  },
  "$ref": "#/$defs/SecretEnvelope"
}
